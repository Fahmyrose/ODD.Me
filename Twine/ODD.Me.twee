:: StoryScript [script]
$(document).on(':passageend', function () {
    $(".fullscreen .text-box br").replaceWith(" ");

    // OPTIONAL SAFE CLEANUP ONLY
    // removes empty text nodes that sometimes appear
    $("#passage").contents().filter(function () {
        return this.nodeType === 3 && !this.nodeValue.trim();
    }).remove();
});

:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Handlee&display=swap');

/* ======================================
   RESET SUGARCUBE (SAFE VERSION)
   ====================================== */

html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
}

body {
    font-family: "Handlee", cursive;
}

/* remove default SugarCube constraints */
#passages, .passage {
    margin: 0;
    padding: 0;
    max-width: none;
}

/* ======================================
   CUSTOM PRELOADER
   ====================================== */

#init-screen {
    background: #000 !important;
}

#init-loading {
    border: none !important;
    width: 120px !important;
    height: 120px !important;

    background-image: url("assets/img/favicon.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;

    animation: logoSpin 2s linear infinite;

    color: transparent !important;
    font-size: 0 !important;
}

#init-loading::before,
#init-loading::after {
    display: none !important;
}

@keyframes logoSpin {
    0%   { transform: rotate(0deg) scale(1); }
    50%  { transform: rotate(180deg) scale(1.05); }
    100% { transform: rotate(360deg) scale(1); }
}

/* ======================================
   FULLSCREEN BACKGROUND SYSTEM
   ====================================== */

.fullscreen {
    width: 100vw;
    height: 100vh;

    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    padding: clamp(1rem, 3vw, 3rem);

    display: flex;
    align-items: center;
    justify-content: flex-start;

    background-color: black; /* important for letterboxing */
    background-size: 0 0 !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
}

/* TRUE BACKGROUND LAYER */
.fullscreen::before {
    content: "";
    position: absolute;
    inset: 0 0 0 clamp(430px, 42vw, 620px);

    background-size: contain;        /* 👈 KEY FIX (no cropping) */
    background-color: black;
    background-repeat: no-repeat;
    background-position: center center;     /* centered image */

    z-index: 0;

    /* image is injected via inline style, so we "inherit" it */
    background-image: inherit;
}

/* Hide SugarCube line breaks generated from passage formatting. */
#passage > br,
.passage > br,
.fullscreen > br {
    display: none;
}

/* ======================================
   TEXT BOX (MAIN UI)
   ====================================== */

.fullscreen .text-box {
    position: relative;
    z-index: 1;

    background: rgba(10, 12, 15, 0.85);
    color: white;

    padding: 1.2rem 1.6rem;
    border-radius: 10px;

    width: min(560px, 44vw);
    max-height: 86vh;
    overflow-y: auto;

    font-size: 24px;
    line-height: 1.6;

    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(6px);
}

@media screen and (max-width: 780px) {
    .fullscreen {
        align-items: flex-end;
        justify-content: center;
        padding: 1rem;
    }

    .fullscreen::before {
        inset: 0;
    }

    .fullscreen .text-box {
        width: min(900px, 92vw);
        max-height: 52vh;
    }
}

/* ======================================
   PARAGRAPHS (FIX SPACING ISSUE)
   ====================================== */

.fullscreen .text-box p {
    margin: 0.9em 0;
}

.fullscreen .identity-title {
    font-size: 1.15em;
}

/* ======================================
   CHOICES (IMPORTANT FIX)
   ====================================== */

a.link-internal {
    display: block;
    margin: 0.6em 0;
}

.start-cover {
    justify-content: center;
    align-items: center;
    text-align: center;
}

.start-cover::before {
    inset: -10px;
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(0.35) saturate(0.9);
    transform: scale(1.04);
}

.start-cover .text-box {
    width: min(500px, 92vw);
    font-size: 18px;
    text-align: center;
    background: rgba(8, 10, 13, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.35);
}

.start-cover .text-box::before {
    content: "";
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    border-radius: 18px;
    background:
        linear-gradient(rgba(0, 0, 0, 0.10), rgba(0, 0, 0, 0.18)),
        url('assets/img/banner.jpg') center/cover no-repeat;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
}

.start-cover .start-cover-title {
    margin-top: 0;
    margin-bottom: 0.35em;
    font-size: 1.2em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.start-cover .start-cover-link {
    display: inline-block;
    margin-top: 0.6em;
    padding: 0.55em 0.9em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

.start-cover .start-cover-link:hover {
    background: rgba(255, 255, 255, 0.18);
}

.intermezzo-cover {
    justify-content: center;
    align-items: center;
    text-align: center;
}

.intermezzo-cover::before {
    inset: -10px;
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(0.35) saturate(0.9);
    transform: scale(1.04);
}

.intermezzo-cover .text-box {
    width: min(860px, 92vw);
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    background: rgba(8, 10, 13, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.35);
}

.intermezzo-cover .text-box p,
.intermezzo-cover .text-box a {
    text-align: center;
}

/* ======================================
   FLOATING TEXT BOX
   ====================================== */

@keyframes floatBox {
    0% {
        transform: translateY(0px);
    }

    50% {
        transform: translateY(-8px);
    }

    100% {
        transform: translateY(0px);
    }
}

.fullscreen .text-box {
    animation: floatBox 5s ease-in-out infinite;
}